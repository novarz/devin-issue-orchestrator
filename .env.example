# ---- Required: GitHub ----
# A token with repo scope on the fork (issues:write, pull_requests:read).
GITHUB_TOKEN=ghp_xxx
# The fork whose issues are remediated, as "owner/name".
GITHUB_REPO=novarz/superset

# ---- Required: Devin v3 API (unless DRY_RUN=true) ----
# Service-user token (starts with "cog_").
DEVIN_API_KEY=cog_xxx
# Organization ID (starts with "org-"); find it in Settings -> Service Users.
DEVIN_ORG_ID=org-xxx
# DEVIN_BASE_URL=https://api.devin.ai/v3

# ---- Orchestration behaviour ----
# Seconds between GitHub Issues polls.
POLL_INTERVAL_SECONDS=60
# Seconds between Devin session status polls.
SESSION_POLL_INTERVAL_SECONDS=30
# Hard cap on how long to wait for a session to finish (seconds).
SESSION_TIMEOUT_SECONDS=3600
# Mandatory ACU cap applied to every session.
MAX_ACU_LIMIT=10
# Mandatory retry cap before escalation (total attempts = MAX_RETRIES + 1).
MAX_RETRIES=2
# Branch a Devin PR must target to pass verification.
EXPECTED_BASE_BRANCH=master
# Label applied when an issue is escalated to a human.
NEEDS_HUMAN_LABEL=needs-human
# Only process issues carrying this label (empty = process all open issues).
ISSUE_LABEL_FILTER=

# ---- Verification ----
# Await the fork's CI on the PR head SHA before passing verification.
VERIFY_AWAIT_CI=true
CI_TIMEOUT_SECONDS=1800
CI_POLL_INTERVAL_SECONDS=30

# ---- HTTP ----
HTTP_TIMEOUT_SECONDS=30

# ---- Logging ----
# Verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Style: "demo" (colourful, icons, single-line) or "plain" (for log shippers).
LOG_FORMAT=demo
# Force colour on/off (1/0). Default: auto (colour only on a TTY). NO_COLOR honoured.
# LOG_COLOR=1

# ---- Testing only ----
# When true, the background poller is NOT started and Devin creds are optional.
DRY_RUN=false
